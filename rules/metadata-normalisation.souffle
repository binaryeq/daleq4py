// Author: Jens Dietrich (https://github.com/jensdietrich/)

// rule to normalise build tools in metadata


.comp MetadataNormalisation {
    .decl is_whitelisted_buildtool(id: symbol, name: symbol)
}

.init metanorm = MetadataNormalisation

// list of whitelisted build tools
// TODO: can refine regex uses to express (semver like) versions, but easy to overfit
metanorm.is_whitelisted_buildtool("R_WHITELISTED_BUILD_TOOL_setuptools",name) :- match("setuptools.*", name);
metanorm.is_whitelisted_buildtool("R_WHITELISTED_BUILD_TOOL_bdist_wheel",name) :- match("bdist_wheel.*", name);

// override generator metadata for whitelisted generators
idb.remove_metadata(cat("R_REMOVE_BUILDER","[",id1,",",id2,",",id3,"]"), "WHEEL", distinfo, "generator") :-
    edb.package(id1,"distinfo",distinfo),
    edb.metadata(id2,"WHEEL", distinfo,"generator",buildtool),
    metanorm.is_whitelisted_buildtool(id3,buildtool);

