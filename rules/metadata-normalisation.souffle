// Author: Jens Dietrich (https://github.com/jensdietrich/)

// rule to normalise build tools in metadata

.comp MetadataNormalisation {
    .decl generator(id: symbol, name: symbol)
    .decl whitelisted_generator(id: symbol, name: symbol)
    .decl wheel_path(id: symbol, name: symbol)
    .decl is_in_metadata_folder(id: symbol, file: symbol, path: symbol,key: symbol)
}

.init metanorm = MetadataNormalisation

metanorm.generator(cat("R_GENERATOR","[",id1,",",id2,"]"),generator) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,"WHEEL", distinfo,"generator",generator).
// list of whitelisted build tools
// TODO: can refine regex uses to express (semver like) versions, but easy to overfit
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_setuptools","[",id,"]"),generator) :- metanorm.generator(id,generator),match("setuptools.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_bdist_wheel","[",id,"]"),generator) :- metanorm.generator(id,generator),match("bdist_wheel.*", generator).

// wheel path is needed to remove the key from RECORD
metanorm.wheel_path(cat("R_WHEEL_PATH","[",id,"]"), cat(distinfo,"/WHEEL")) :- edb.package(id,"distinfo",distinfo).

// override generator metadata for whitelisted generators, then remove entry from record as hash is no longer valid
idb.remove_content(cat("R_REMOVE_BUILDER","[",id1,",",id2,",",id3,"]"), "WHEEL", distinfo, "generator") :- edb.package(id1,"distinfo",distinfo),edb.content(id2,"WHEEL", distinfo,"generator",generator),metanorm.whitelisted_generator(id3,generator).
idb.remove_content(cat("R_REMOVE_WHEELPATH_FROM_RECORD","[",id1,",",id2,"]"), "RECORD", distinfo, wheelpath) :- metanorm.wheel_path(id1,wheelpath),idb.remove_content(id2, "WHEEL", distinfo, "generator").

// ignore metadata hashes as they are generated by build
idb.remove_content(cat("R_IGNORE_METADATA_HASHES","[",id1,",",id2,"]"), name, distinfo, key) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,name, distinfo,key,_),match("@.*", key).

// normalise location of LICENSE and AUTHORS, always move them into <distinfo>/licenses
metanorm.is_in_metadata_folder(cat("R_IS_METADATA_FOLDER","[",id1,",",id2,"]"),file,path,key) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,file,path,key,_),match(cat(distinfo,".*"), path).
idb.remove_content(cat("R_RELOCATE_LICENSE_RM","[",id1,"]"), "LICENSE", path, key) :- metanorm.is_in_metadata_folder(id1, "LICENSE",path,key).
idb.content(cat("R_RELOCATE_LICENSE_MV)","[",id1,",",id2,"]"), "LICENSE", cat(distinfo,"/licenses"), key,value) :- edb.content(id1,name, distinfo,key,value), metanorm.is_in_metadata_folder(id2,"LICENSE",path,key).
idb.remove_content(cat("R_RELOCATE_AUTHORS_RM","[",id1,"]"), "AUTHORS", path, key) :- metanorm.is_in_metadata_folder(id1, "AUTHORS",path,key).
idb.content(cat("R_RELOCATE_AUTHORS_MV)","[",id1,",",id2,"]"), "AUTHORS", cat(distinfo,"/licenses"), key,value) :- edb.content(id1,name, distinfo,key,value), metanorm.is_in_metadata_folder(id2,"AUTHORS",path,key).
