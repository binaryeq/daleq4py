// Author: Jens Dietrich (https://github.com/jensdietrich/)

// rule to normalise build tools in metadata

.comp MetadataNormalisation {
    .decl generator(id: symbol, name: symbol)
    .decl whitelisted_generator(id: symbol, name: symbol)
    .decl wheel_path(id: symbol, name: symbol)
    .decl is_in_metadata_folder(id: symbol, file: symbol, path: symbol,key: symbol)
    .decl metadata_version(id: symbol, path: symbol, version: symbol)
    .decl has_higher_metadata_version(id: symbol, version: symbol)
    .decl target_metadata_version(id: symbol, version: symbol)
    .decl metadata_version_is_less_than(version1: symbol, version2: symbol)
    .decl non_dynamic_headers(key: symbol)
    .decl metadata_key_has_lower_value(id: symbol, key: symbol, value: symbol)
    .decl unique_metadata_key(id: symbol, key: symbol)
    .decl original_key_name_for_packaging_name(packaging_key: symbol, original_key: symbol)
}

.init metanorm = MetadataNormalisation

metanorm.generator(cat("R_GENERATOR","[",id1,",",id2,"]"),generator) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,"WHEEL", distinfo,"generator",generator).
// list of whitelisted build tools
// TODO: can refine regex uses to express (semver like) versions, but easy to overfit
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_setuptools","[",id,"]"),generator) :- metanorm.generator(id,generator),match("setuptools.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_bdist_wheel","[",id,"]"),generator) :- metanorm.generator(id,generator),match("bdist_wheel.*", generator).
// other common PEP 517 build backends. The prefix patterns are deliberately
// broad so they also cover family members and the version suffix, e.g.
// "poetry.*" matches both "poetry" and "poetry-core", "pdm.*" matches
// "pdm-backend" and "pdm-pep517", "scikit-build.*" matches "scikit-build-core".
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_flit","[",id,"]"),generator) :- metanorm.generator(id,generator),match("flit.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_poetry","[",id,"]"),generator) :- metanorm.generator(id,generator),match("poetry.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_hatchling","[",id,"]"),generator) :- metanorm.generator(id,generator),match("hatchling.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_pdm","[",id,"]"),generator) :- metanorm.generator(id,generator),match("pdm.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_maturin","[",id,"]"),generator) :- metanorm.generator(id,generator),match("maturin.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_scikit_build","[",id,"]"),generator) :- metanorm.generator(id,generator),match("scikit-build.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_meson","[",id,"]"),generator) :- metanorm.generator(id,generator),match("meson.*", generator).
metanorm.whitelisted_generator(cat("R_WHITELISTED_GENERATOR_whey","[",id,"]"),generator) :- metanorm.generator(id,generator),match("whey.*", generator).

// wheel path is needed to remove the key from RECORD
metanorm.wheel_path(cat("R_WHEEL_PATH","[",id,"]"), cat(distinfo,"/WHEEL")) :- edb.package(id,"distinfo",distinfo).

// override generator metadata for whitelisted generators, then remove entry from record as hash is no longer valid
idb.remove_content(cat("R_REMOVE_BUILDER","[",id1,",",id2,",",id3,"]"), "WHEEL", distinfo, "generator") :- edb.package(id1,"distinfo",distinfo),edb.content(id2,"WHEEL", distinfo,"generator",generator),metanorm.whitelisted_generator(id3,generator).
idb.remove_content(cat("R_REMOVE_WHEELPATH_FROM_RECORD","[",id1,",",id2,"]"), "RECORD", distinfo, wheelpath) :- metanorm.wheel_path(id1,wheelpath),idb.remove_content(id2, "WHEEL", distinfo, "generator").

// ignore metadata hashes as they are generated by build
idb.remove_content(cat("R_IGNORE_METADATA_HASHES","[",id1,",",id2,"]"), name, distinfo, key) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,name, distinfo,key,_),match("@.*sha256", key).

// Ignore raw unnormalised Requires-Dist headers -- we will use the derived normalised ones instead.
// As a partial safety check, only do this removal if at least one @norm/requires_dist fact is also present.
//TODO: Strengthen this check (issue #8)
idb.remove_content(cat("R_IGNORE_RAW_REQUIRES_DIST", "[", id1, "]"), "METADATA", distinfo, "requires_dist") :- edb.package(id1, "distinfo", distinfo), edb.content(_, "METADATA", distinfo, "@norm/requires_dist", _).

// normalise location of LICENSE and AUTHORS, always move them into <distinfo>/licenses
metanorm.is_in_metadata_folder(cat("R_IS_METADATA_FOLDER","[",id1,",",id2,"]"),file,path,key) :- edb.package(id1,"distinfo",distinfo),edb.content(id2,file,path,key,_), distinfo = path.
idb.remove_content(cat("R_RELOCATE_LICENSE_RM","[",id1,"]"), "LICENSE", path, key) :- metanorm.is_in_metadata_folder(id1, "LICENSE",path,key).
idb.content(cat("R_RELOCATE_LICENSE_MV","[",id1,",",id2,",",id3,"]"), "LICENSE", cat(distinfo,"/licenses"), key,value) :- edb.package(id1,"distinfo",distinfo), metanorm.is_in_metadata_folder(id2,"LICENSE",path,key), edb.content(id3,"LICENSE",path,key,value).
idb.remove_content(cat("R_RELOCATE_LICENSE_IN_RECORD_RM","[",id1,",",id2,"]"), "RECORD", distinfo, cat(path, "/LICENSE")) :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "LICENSE", path, _).
idb.content(cat("R_RELOCATE_LICENSE_IN_RECORD_MV","[",id1,",",id2,",",id3,"]"), "RECORD", distinfo, cat(path, "/licenses/LICENSE"), value) :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "LICENSE", path, key), edb.content(id3, "RECORD", distinfo, cat(path, "/LICENSE"), value).

idb.remove_content(cat("R_RELOCATE_AUTHORS_RM","[",id1,"]"), "AUTHORS", path, key) :- metanorm.is_in_metadata_folder(id1, "AUTHORS",path,key).
idb.content(cat("R_RELOCATE_AUTHORS_MV","[",id1,",",id2,",",id3,"]"), "AUTHORS", cat(distinfo,"/licenses"), key,value) :- edb.package(id1,"distinfo",distinfo), metanorm.is_in_metadata_folder(id2,"AUTHORS",path,key), edb.content(id3,"AUTHORS",path,key,value).
idb.remove_content(cat("R_RELOCATE_AUTHORS_IN_RECORD_RM","[",id1,",",id2,"]"), "RECORD", distinfo, cat(path, "/AUTHORS")) :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "AUTHORS", path, _).
idb.content(cat("R_RELOCATE_AUTHORS_IN_RECORD_MV","[",id1,",",id2,",",id3,"]"), "RECORD", distinfo, cat(path, "/licenses/AUTHORS"), value) :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "AUTHORS", path, key), edb.content(id3, "RECORD", distinfo, cat(path, "/AUTHORS"), value).

// In RECORD, ignore the file hash and size of METADATA -- instead we deal with its individual possibly normalised keys.
// Use the @sha256 keys for METADATA and RECORD just because we know exactly 1 of each exists, resulting in 1 fact.
idb.remove_content(cat("R_NORMALISE_METADATA_IN_RECORD_RM", "[", id1, "]"), "RECORD", distinfo, cat(distinfo, "/METADATA")) :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "METADATA", path, _).
idb.content(cat("R_NORMALISE_METADATA_IN_RECORD_MV", "[", id1, ",", id2, ",", id3, "]"), "RECORD", distinfo, cat(distinfo, "/METADATA"), "<IGNORED>") :- edb.package(id1, "distinfo", distinfo), metanorm.is_in_metadata_folder(id2, "METADATA", path, "@sha256"), metanorm.is_in_metadata_folder(id3, "RECORD", path, "@sha256").

// In metadata versions < 2.2, all headers except for Name, Version, and Metadata-Version should be considered
// dynamic, i.e., as though a "Dynamic: that_header" line appeared. Normalise by "promoting" through every
// metadata version, adding these headers whenever we promote from 2.1 to 2.2.
//
// See https://packaging.python.org/en/latest/specifications/core-metadata/#dynamic-multiple-use

// Constants

// The target version to normalise (promote) every metadata version to. Should be a recent version.
//TODO: Sanity-check that metanorm.metadata_version() is true for this version.
metanorm.target_metadata_version("R_TARGET_METADATA_VERSION", "2.5").

// Headers that are NOT implicit-Dynamic before metadata v2.2
metanorm.non_dynamic_headers("name").
metanorm.non_dynamic_headers("version").
metanorm.non_dynamic_headers("metadata_version").
metanorm.non_dynamic_headers("requires_dist").	// Not listed as non-dynamic in the spec, but at least setuptools 80.9.0 treats it this way

//TODO: Use conversion to an FP numeric type to avoid hardcoding this
metanorm.metadata_version_is_less_than("1.0", "1.1").
metanorm.metadata_version_is_less_than("1.1", "1.2").
metanorm.metadata_version_is_less_than("1.2", "2.1").
metanorm.metadata_version_is_less_than("2.1", "2.2").
metanorm.metadata_version_is_less_than("2.2", "2.3").
metanorm.metadata_version_is_less_than("2.3", "2.4").
metanorm.metadata_version_is_less_than("2.4", "2.5").
metanorm.metadata_version_is_less_than(u, v) :- metanorm.metadata_version_is_less_than(u, w), metanorm.metadata_version_is_less_than(w, v).

// Unfortunately the "packaging" Python module introduces subtle METADATA key name differences (hyphens become
// underscores, some keys are pluralised), meaning we need to undo this transform in order to synthesise
// Dynamic: headers. The following table is based on _EMAIL_TO_RAW_MAPPING from
// https://github.com/pypa/packaging/blob/07265129295b4b95b9143b50e3ce4709f31a8c49/src/packaging/metadata.py.
metanorm.original_key_name_for_packaging_name("author", "author").
metanorm.original_key_name_for_packaging_name("author_email", "author-email").
metanorm.original_key_name_for_packaging_name("classifiers", "classifier").
metanorm.original_key_name_for_packaging_name("description", "description").
metanorm.original_key_name_for_packaging_name("description_content_type", "description-content-type").
metanorm.original_key_name_for_packaging_name("download_url", "download-url").
metanorm.original_key_name_for_packaging_name("dynamic", "dynamic").
metanorm.original_key_name_for_packaging_name("home_page", "home-page").
metanorm.original_key_name_for_packaging_name("import_names", "import-name").
metanorm.original_key_name_for_packaging_name("import_namespaces", "import-namespace").
metanorm.original_key_name_for_packaging_name("keywords", "keywords").
metanorm.original_key_name_for_packaging_name("license", "license").
metanorm.original_key_name_for_packaging_name("license_expression", "license-expression").
metanorm.original_key_name_for_packaging_name("license_files", "license-file").
metanorm.original_key_name_for_packaging_name("maintainer", "maintainer").
metanorm.original_key_name_for_packaging_name("maintainer_email", "maintainer-email").
metanorm.original_key_name_for_packaging_name("metadata_version", "metadata-version").
metanorm.original_key_name_for_packaging_name("name", "name").
metanorm.original_key_name_for_packaging_name("obsoletes", "obsoletes").
metanorm.original_key_name_for_packaging_name("obsoletes_dist", "obsoletes-dist").
metanorm.original_key_name_for_packaging_name("platforms", "platform").
metanorm.original_key_name_for_packaging_name("project_urls", "project-url").
metanorm.original_key_name_for_packaging_name("provides", "provides").
metanorm.original_key_name_for_packaging_name("provides_dist", "provides-dist").
metanorm.original_key_name_for_packaging_name("provides_extra", "provides-extra").
metanorm.original_key_name_for_packaging_name("requires", "requires").
metanorm.original_key_name_for_packaging_name("requires_dist", "requires-dist").
metanorm.original_key_name_for_packaging_name("requires_external", "requires-external").
metanorm.original_key_name_for_packaging_name("requires_python", "requires-python").
metanorm.original_key_name_for_packaging_name("summary", "summary").
metanorm.original_key_name_for_packaging_name("supported_platforms", "supported-platform").
metanorm.original_key_name_for_packaging_name("version", "version").

// Compute the final metadata version that we promote to, along with additional facts implied by each version change
// Each metadata version can be promoted to the immediate successor version.
metanorm.metadata_version(cat("R_METADATA_VERSION", "[", id1, ",", id2, "]"), distinfo, version) :- edb.package(id1, "distinfo", distinfo), edb.content(id2, "METADATA", distinfo, "metadata_version", version).
metanorm.has_higher_metadata_version(cat("R_HAS_HIGHER_METADATA_VERSION", "[", id1, ",", id2, "]"), version) :- metanorm.metadata_version(id1, path, version), metanorm.metadata_version(id2, path, higher_version), metanorm.metadata_version_is_less_than(version, higher_version).

metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_1_1", "[", id1, "]"), path, "1.1") :- metanorm.metadata_version(id1, path, "1.0").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_1_2", "[", id1, "]"), path, "1.2") :- metanorm.metadata_version(id1, path, "1.1").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_2_1", "[", id1, "]"), path, "2.1") :- metanorm.metadata_version(id1, path, "1.2").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_2_2", "[", id1, "]"), path, "2.2") :- metanorm.metadata_version(id1, path, "2.1").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_2_3", "[", id1, "]"), path, "2.3") :- metanorm.metadata_version(id1, path, "2.2").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_2_4", "[", id1, "]"), path, "2.4") :- metanorm.metadata_version(id1, path, "2.3").
metanorm.metadata_version(cat("R_PROMOTE_METADATA_VERSION_TO_2_5", "[", id1, "]"), path, "2.5") :- metanorm.metadata_version(id1, path, "2.4").

// When promoting metadata version 2.1 to 2.2, add in the implied Dynamic: headers for each unique present and relevant header
// To construct the provenance (ID) for unique_metadata_key(), we need to *deterministically* choose a witness value.
// One way is to choose the lexicographically minimum key. Since Souffle 2.5 doesn't support min for symbol types
// (see https://github.com/souffle-lang/souffle/issues/2589), choose the minimum "the hard way".
metanorm.metadata_key_has_lower_value(cat("R_METADATA_KEY_HAS_LOWER_VALUE", "[", id1, ",", id2, ",", id3, "]"), key, value) :- edb.package(id1, "distinfo", distinfo), edb.content(id2, "METADATA", distinfo, key, value), edb.content(id3, "METADATA", distinfo, key, lower_value), lower_value < value.
metanorm.unique_metadata_key(cat("R_UNIQUE_METADATA_KEY", "[", id1, ",", id2, "]"), key) :- edb.package(id1, "distinfo", distinfo), edb.content(id2, "METADATA", distinfo, key, value), !metanorm.metadata_key_has_lower_value(_, key, value).
idb.content(cat("R_IMPLICIT_DYNAMIC_HEADER", "[", id1, ",", id2, ",", id3, "]"), "METADATA", path, "dynamic", original_key) :- metanorm.unique_metadata_key(id1, packaging_key), metanorm.original_key_name_for_packaging_name(packaging_key, original_key), metanorm.metadata_version(id2, path, "2.1"), metanorm.metadata_version(id3, path, "2.2"), !contains("@", original_key), !metanorm.non_dynamic_headers(packaging_key).

// Finally, add the normalised versions of the raw EDB facts into the IDB
idb.remove_content(cat("R_PROMOTE_METADATA_VERSION_RM", "[", id1, ",", id2, "]"), "METADATA", path, "metadata_version") :- metanorm.metadata_version(id1, path, version), metanorm.has_higher_metadata_version(id2, version).
idb.content(cat("R_PROMOTE_METADATA_VERSION_MV", "[", id1, "]"), "METADATA", path, "metadata_version", final_version) :- metanorm.metadata_version(id1, path, final_version), !metanorm.has_higher_metadata_version(_, final_version).
